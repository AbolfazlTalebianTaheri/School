# آدرس API که Vite در حالت dev درخواست‌های /api را به آن می‌فرستد
# (پروفایل https پروژه .NET: https://localhost:7037 ، پروفایل http: http://localhost:5106)
VITE_API_PROXY_TARGET=https://localhost:7037

# فقط وقتی فرانت و API روی دامنه‌های جدا هستند (مثلاً production) تنظیم شود
# VITE_API_BASE_URL=https://api.example.com/api/v1
